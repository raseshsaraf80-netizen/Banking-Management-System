# Copy this file to .env and fill in values before running locally.
# Never commit .env to version control.

# Path to SQLite database file (default: ./bank.db)
BANK_DB_PATH=./bank.db

# Port for Javalin REST API server (default: 7070)
PORT=7070

# Allowed CORS origin for the static web frontend (e.g., https://your-app.vercel.app or http://localhost:5500)
FRONTEND_ORIGIN=http://localhost:5500

# Signing secret for session tokens (change in production)
TOKEN_SECRET=dev-banking-secret-change-me

# Anthropic API configuration (server-side only; keep secret!)
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-sonnet-5-5

